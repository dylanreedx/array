<figure class="native-demo" id="demo" data-native-film aria-label="Array running on macOS">
  <video muted playsinline preload="none" data-poster="/videos/array-native-tour.jpg" data-src="/videos/array-native-tour.mp4" aria-label="Recorded Array workflow: task, agent, code, tests and approval" />
  <figcaption>Array, running on macOS.</figcaption>
</figure>

<script>
  const film = document.querySelector<HTMLElement>('[data-native-film]');
  const video = film?.querySelector('video');
  const track = film?.closest<HTMLElement>('[data-assembly-root]');
  if (film && video && track) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let target = 0;
    let loaded = false;
    const load = () => {
      if (loaded) return;
      loaded = true;
      video.poster = video.dataset.poster!;
      video.src = video.dataset.src!;
      video.load();
    };
    const seek = () => {
      if (reduced.matches || video.readyState < 1 || video.seeking) return;
      const time = Math.min(Math.max(0, video.duration - .1), target * video.duration);
      if (Math.abs(video.currentTime - time) > .055) video.currentTime = time;
    };
    video.addEventListener('loadedmetadata', seek);
    video.addEventListener('seeked', () => {
      film.dataset.frameTime = video.currentTime.toFixed(2);
      seek();
    });
    track.addEventListener('array:assembly', (event) => {
      const { progress } = (event as CustomEvent<{ progress: number }>).detail;
      target = Math.max(0, Math.min(1, (progress - .42) / .58));
      if (progress > .24) load();
      seek();
    });
    const updateMotion = () => {
      video.controls = reduced.matches;
      if (reduced.matches) load();
      else { video.pause(); seek(); }
    };
    reduced.addEventListener('change', updateMotion);
    updateMotion();
  }
</script>
