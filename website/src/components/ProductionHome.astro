---
import ProductionLayout from '../layouts/ProductionLayout.astro';
import SiteHeader from './marketing/SiteHeader.astro';
import GuidedWorkspace from './demo/GuidedWorkspace';
import DownloadSplit from './marketing/DownloadSplit.astro';
import '../styles/restored-hero.css';
import { canonicalCopy } from '../features/demo/fixture';
---
<ProductionLayout title="Array · Keep every agent in view" description="A native Mac workspace for coding agents. Claude Code, Codex and Pi side by side, next to their terminals, browser previews and diffs. Free and open source.">
  <SiteHeader />
  <main>
    <section class="living-assembly" id="product" data-assembly-root data-guided-demo data-testid="hero-scroll-track">
      <div class="living-assembly__sticky" data-testid="hero-pin">
        <div class="hero-copy">
          <h1 data-testid="hero-heading">{canonicalCopy.headline}</h1>
          <p class="hero-copy__body">{canonicalCopy.body}</p>
          <div class="hero-copy__actions">
            <DownloadSplit idPrefix="hero" />
            <button type="button" class="see-all" data-see-all data-interaction-id="hero-see-all">{canonicalCopy.secondary}</button>
          </div>
          <p class="hero-copy__requirements">{canonicalCopy.requirements}</p>
          <a class="ph-badge" href="https://www.producthunt.com/products/array-5?embed=true&amp;utm_source=badge-featured&amp;utm_medium=badge&amp;utm_campaign=badge-array-5" target="_blank" rel="noopener noreferrer" data-testid="ph-badge-hero"><img class="ph-badge__img ph-badge__img--light" alt="Array - Stop losing your agents in your terminal | Product Hunt" width="250" height="54" src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1286053&amp;theme=light" /><img class="ph-badge__img ph-badge__img--dark" alt="Array - Stop losing your agents in your terminal | Product Hunt" width="250" height="54" src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1286053&amp;theme=dark" /></a>
        </div>
        <div class="living-workspace" id="workspace">
          <GuidedWorkspace />
        </div>
      </div>
      <span class="assembly-anchor assembly-anchor--companion" id="companion" aria-hidden="true"></span>
      <span class="assembly-anchor assembly-anchor--ready" id="agents" aria-hidden="true"></span>
    </section>

    <noscript>
      <style is:inline>
        .living-assembly[data-guided-demo] { height: auto; }
        .living-assembly__sticky { position: relative; height: auto; overflow: visible; }
        .hero-copy { position: relative; top: auto; left: auto; margin: 0 auto; padding-top: 125px; opacity: 1 !important; transform: none; }
        .living-workspace { display: none; }
        .demo-without-script { max-width: 620px; margin: 64px auto; padding: 0 24px; color: var(--ink-2); font-size: 17px; line-height: 1.6; text-wrap: pretty; }
      </style>
      <p class="demo-without-script">Group work in zones on a canvas. Give Claude Code, Codex, or Pi a task in its own tile. Keep terminals, notes, and browsers beside the work, and review approvals when an agent needs you.</p>
    </noscript>
    <section class="final-cta">
      <h2>Stop losing your agents in your terminal.</h2>
      <p>Download Array for Mac and keep every agent in view.</p>
      <DownloadSplit idPrefix="final" />
      <small>{canonicalCopy.requirements}</small>
      <a class="ph-badge" href="https://www.producthunt.com/products/array-5?embed=true&amp;utm_source=badge-featured&amp;utm_medium=badge&amp;utm_campaign=badge-array-5" target="_blank" rel="noopener noreferrer" data-testid="ph-badge-final"><img class="ph-badge__img ph-badge__img--light" alt="Array - Stop losing your agents in your terminal | Product Hunt" width="250" height="54" src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1286053&amp;theme=light" /><img class="ph-badge__img ph-badge__img--dark" alt="Array - Stop losing your agents in your terminal | Product Hunt" width="250" height="54" src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1286053&amp;theme=dark" /></a>
    </section>
  </main>
  <footer class="production-footer">
    <a href="/" aria-label="Array home" data-interaction-id="footer-home">Array</a>
    <nav aria-label="Footer"><a href="https://github.com/dylanreedx/array">GitHub</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></nav>
    <a href="https://github.com/dylanreedx/array-releases/issues">Feedback ↗</a>
  </footer>
</ProductionLayout>

<script>
  import { installAssembly } from '../lib/assembly-controller';
  import { installGuidedDemo } from '../lib/guided-demo';
  installGuidedDemo();
  installAssembly();
</script>
