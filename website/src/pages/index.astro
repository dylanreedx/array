---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import CanvasDemo from '../components/CanvasDemo.astro';
import PhoneDemo from '../components/PhoneDemo.astro';
import AgentWorkspaceDemo from '../components/AgentWorkspaceDemo.astro';
import NavigationDemo from '../components/NavigationDemo.astro';
---

<BaseLayout
  title="Array — A spatial workspace for coding agents"
  description="Array brings projects, coding agents, terminals, browsers, and development tools together on one spatial canvas."
>
  <main id="top">
    <nav class="site-nav shell" aria-label="Primary navigation">
      <Logo />
      <div class="site-nav__links">
        <a href="#canvas">Canvas</a>
        <a href="#agents">Agents</a>
        <a href="#navigation">Navigation</a>
        <a href="#remote">Remote</a>
      </div>
      <div class="site-nav__actions">
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme">
          <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path></svg>
          <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.2A8.4 8.4 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z"></path></svg>
        </button>
        <a class="button button--small" href="https://github.com/dylanreedx/array-releases/releases/latest/download/Array.dmg">Download <span>↓</span></a>
      </div>
    </nav>

    <section class="hero shell">
      <div class="hero__copy" data-reveal>
        <h1>Your whole development world, <em>in view.</em></h1>
        <p>
          Array brings projects, coding agents, terminals, browsers, and servers onto one spatial
          canvas—so more work can run without more of it living in your head.
        </p>
        <div class="hero__actions">
          <a class="button" href="https://github.com/dylanreedx/array-releases/releases/latest/download/Array.dmg">Download for macOS <span>↓</span></a>
          <a class="text-link" href="#canvas">See how it works <span>↓</span></a>
        </div>
        <p class="hero__requirements">macOS 14+ · Apple Silicon · free while in alpha</p>
      </div>

      <div class="hero__visual" data-reveal>
        <CanvasDemo />
      </div>
    </section>

    <section class="spatial-section shell" id="canvas">
      <div class="section-heading" data-reveal>
        <h2>Recall less.<br /><em>Recognize more.</em></h2>
        <p>
          Every project and active surface keeps a stable place. Instead of reconstructing an invisible
          stack of sessions, you can read your workspace at a glance and pick up where you left off.
        </p>
      </div>

      <div class="workspace-story" data-reveal>
        <div class="workspace-story__topbar">
          <div><span class="workspace-avatar">W</span><div><strong>Identity workspace</strong><small>4 live surfaces in this zone</small></div></div>
          <div class="workspace-story__actions"><button type="button" tabindex="-1">Fit zone</button><button type="button" tabindex="-1">•••</button></div>
        </div>
        <div class="workspace-story__canvas">
          <div class="story-zone">
            <div class="story-zone__label"><strong>Identity</strong><span>Auth and session work</span></div>
            <article class="story-tile story-tile--agent">
              <header><span class="status-dot status-dot--pulse"></span><strong>Auth agent</strong><small>Working</small></header>
              <p>Updating passkey enrollment</p>
              <div class="story-progress"><i></i><span>2 of 3 steps</span></div>
            </article>
            <article class="story-tile story-tile--browser">
              <header><span>◫</span><strong>Browser</strong><small>localhost:3000</small></header>
              <div class="story-browser"><i></i><i></i><strong>Sign in with a passkey</strong><button type="button" tabindex="-1">Continue</button></div>
            </article>
            <article class="story-tile story-tile--server">
              <header><span>›_</span><strong>Dev server</strong><small>Live</small></header>
              <code>ready at localhost:3000</code>
            </article>
            <article class="story-tile story-tile--review">
              <header><span>±</span><strong>Review</strong><small>8 files</small></header>
              <div class="story-diff"><i></i><i></i><i></i></div>
            </article>
          </div>
        </div>
        <div class="workspace-story__footer">
          <div><span class="friendly-icon">⌁</span><p><strong>Keep related work together</strong><small>The agent, app, server, and review live in one visible region.</small></p></div>
          <div><span class="friendly-icon">↗</span><p><strong>Leave it where it makes sense</strong><small>Zones and tile positions persist as your project evolves.</small></p></div>
          <div><span class="friendly-icon">⌘</span><p><strong>Return without rebuilding context</strong><small>Open the workspace and continue from its current state.</small></p></div>
        </div>
      </div>
    </section>

    <section class="agents-section" id="agents">
      <div class="shell">
        <div class="section-heading section-heading--center" data-reveal>
          <h2>Agents stay on the canvas.<br /><em>Their state stays in view.</em></h2>
          <p>
            The sidebar shows every agent across the workspace and brings the selected tile into focus.
            The full agent interface remains on the canvas beside the browser, server, and work it belongs with.
          </p>
        </div>

        <div data-reveal><AgentWorkspaceDemo /></div>

        <div class="agent-principles" data-reveal>
          <article><span class="principle-icon">⌁</span><h3>Isolated work, clearly owned.</h3><p>Each delegated agent can keep its own worktree while remaining grouped with the project that created it.</p></article>
          <article><span class="principle-icon">◫</span><h3>The view is not the process.</h3><p>Close or move an agent tile without losing its identity, history, or running work. Open it again where it belongs.</p></article>
          <article><span class="principle-icon">◆</span><h3>Attention has one clear place.</h3><p>Approvals, questions, failures, and completed work are visible across projects instead of hiding in terminal tabs.</p></article>
        </div>
      </div>
    </section>

    <section class="navigation-section shell" id="navigation">
      <div class="section-heading" data-reveal>
        <h2>Jump straight to the tile you need.</h2>
        <p>
          Hold Option and Array labels every visible tile except the one already focused. Press a label
          to focus and center its tile at the current zoom, or use ⌘K when you know the title.
        </p>
      </div>
      <div data-reveal><NavigationDemo /></div>
    </section>

    <section class="remote-section shell" id="remote" data-reveal>
      <div class="remote-panel">
        <div class="remote-panel__copy">
          <span class="soft-pill">Companion preview</span>
          <h2>The canvas stays on your Mac.<br /><em>The workspace goes with you.</em></h2>
          <p>
            Your phone does not need a miniature infinite canvas. It needs the live state of every
            workspace, a clear queue of what needs attention, and a direct path back into the agent.
          </p>
          <ul class="remote-list">
            <li><span>✓</span>See live agent state across workspaces</li>
            <li><span>✓</span>Answer approvals and agent questions</li>
            <li><span>✓</span>Keep remote work moving away from your desk</li>
          </ul>
        </div>
        <div class="remote-panel__visual">
          <div class="remote-orbit remote-orbit--one"></div>
          <div class="remote-orbit remote-orbit--two"></div>
          <PhoneDemo />
          <div class="remote-signal"><i></i><span>Workspace state synced</span></div>
        </div>
      </div>
    </section>

    <section class="access-section shell" id="access" data-reveal>
      <div class="access-section__mark" aria-hidden="true">
        <img class="access-logo access-logo--light" src="/array-logo-light.svg" alt="" />
        <img class="access-logo access-logo--dark" src="/array-logo-dark.svg" alt="" />
      </div>
      <div class="access-section__copy">
        <h2>Make room for everything you’re building.</h2>
        <p>Array is in active development for macOS. Download the alpha and help shape a workspace built for parallel development.</p>
      </div>
      <div class="access-section__actions">
        <a class="button" href="https://github.com/dylanreedx/array-releases/releases/latest/download/Array.dmg">Download for macOS <span>↓</span></a>
        <a class="text-link" href="https://github.com/dylanreedx/array-releases/issues">Report a problem <span>↗</span></a>
      </div>
    </section>

    <footer class="site-footer shell">
      <Logo />
      <p>A spatial workspace for coding agents.</p>
      <div><span>© 2026 Array</span><a href="#top">Back to top ↑</a></div>
    </footer>
  </main>
</BaseLayout>
