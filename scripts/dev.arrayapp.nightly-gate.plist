<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>dev.arrayapp.nightly-gate</string>
<!-- The install command fills absolute paths in this template. -->
<key>ProgramArguments</key><array><string>/bin/bash</string><string>__NIGHTLY_SCRIPT__</string></array>
<!-- Hourly, per change: a new integration head is gated (and its release
     candidate built) within the hour; an already-gated head exits in seconds.
     No fixed nightly slot: the Mac's scheduled 03:00 sleep would cut it off. -->
<key>StartInterval</key><integer>3600</integer>
<key>ProcessType</key><string>Background</string>
</dict></plist>
