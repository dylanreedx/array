{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@website/*": ["../website/src/*"],
      "@website-public/*": ["../website/public/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["src", "kit", "looks", "videos", "probes", "scripts", "remotion.config.ts", "css.d.ts", "legacy/lib/assets.d.ts"],
  "exclude": ["node_modules", "renders", "videos/hero-loop", "videos/what-is-array", "videos/canvas-tour"]
}
